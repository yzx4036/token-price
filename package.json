{
  "name": "token-price",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs && node scripts/site-domain.mjs --write && node scripts/site-seo.mjs && node scripts/gen-llms-txt.mjs",
    "build:client": "node node_modules/vite/bin/vite.js build",
    "build:ssr": "node scripts/build-ssr.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "data": "node scripts/data/cli.mjs",
    "data:rate": "node scripts/data/cli.mjs rate",
    "data:pull": "node scripts/data/cli.mjs pull",
    "data:verify": "node scripts/data/cli.mjs verify",
    "data:drift": "node scripts/data/cli.mjs drift",
    "data:add": "node scripts/data/cli.mjs add",
    "publish": "node scripts/data/cli.mjs publish",
    "domain": "node scripts/site-domain.mjs",
    "domain:set": "node scripts/site-domain.mjs --set",
    "domain:show": "node scripts/site-domain.mjs --show",
    "domain:check": "node scripts/site-domain.mjs --check",
    "data:estimates": "node scripts/data/gen-token-estimates.mjs",
    "data:benchmarks": "node scripts/data/gen-benchmarks.mjs",
    "data:derived:check": "node scripts/data/gen-token-estimates.mjs --check && node scripts/data/gen-benchmarks.mjs --check"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
