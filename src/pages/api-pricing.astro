---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apiPrices, DATA_VERIFIED_AT, fxRate, providers } from '../lib/data';
import { computeStats } from '../lib/stats';
import { formatContextTokens, priceBasisLabel, priceCells, provenanceLabel } from '../lib/format';
import { RATE_DISCLAIMER, formatRate } from '../lib/fx';
import { filterAndSortApiPrices } from '../lib/pricing';

const stats = computeStats(apiPrices);
const sorted = filterAndSortApiPrices(apiPrices, { sortBy: 'inputPrice' }, fxRate);
const rows = sorted.map((item) => ({
  item,
  cells: priceCells(item, fxRate),
  context: formatContextTokens(item.contextTokens),
  provenance: provenanceLabel(item),
  basis: priceBasisLabel(item, fxRate),
}));
const providerOptions = providers
  .filter((provider) => stats.providers > 0 && apiPrices.some((entry) => entry.providerId === provider.id))
  .map((provider) => ({ id: provider.id, label: provider.nameZh }));
const clientData = JSON.stringify({ models: apiPrices, fx: fxRate }).replaceAll('<', '\\u003c');
---
<BaseLayout title="API 比价（原币种原价 + 人民币估算）" description="AI API 价格表：美元条目以厂商美元原价为主、人民币为按汇率估算的参考值；人民币条目给官方原价，逐条标注溯源等级。">
  <section class="hero">
    <div class="eyebrow">API Pricing</div>
    <h1>按量 API 比价（原币种原价 + 人民币估算）</h1>
    <p class="lede">主列永远是厂商账单币种的原价：国际厂商显示美元，国内厂商显示人民币。人民币只作为国际厂商的估算副行出现，并标注汇率与日期。表格先按账单币种分组，再在组内按原币种价格升序，不做跨币种的「最便宜」合并排名。</p>
    <p class="meta">官方核验日期：{DATA_VERIFIED_AT} · 共 {stats.entries} 条口径 / {stats.providers} 家厂商 · 官方核验 {stats.official} 条 · 聚合数据 {stats.aggregate} 条 · 汇率 1 USD = {fxRate.rate} CNY（{fxRate.date}）</p>
  </section>

  <div class="callout">
    <p><strong>币种口径：</strong>美元为厂商原价；人民币为按 {formatRate(fxRate.rate)} 估算的参考值，汇率随时变化，不准确。</p>
    <p>{RATE_DISCLAIMER}</p>
    <p class="meta">官方核验条目里，人民币挂牌的即官方原价；美元挂牌的只给美元原价，人民币一律标「≈」与「估算」。聚合数据由聚合源以 USD 发布（国内厂商的数值折算自人民币挂牌价），一律标注「聚合数据」，不标「官方原价」。</p>
  </div>

  <form class="controls controls-wide" id="api-controls" aria-label="API 价格筛选">
    <label>搜索厂商或模型<input type="search" name="query" placeholder="例如 qwen、Gemini、deepseek" /></label>
    <label>厂商<select name="provider"><option value="">全部厂商</option>{providerOptions.map((provider) => <option value={provider.id}>{provider.label}</option>)}</select></label>
    <label>溯源<select name="provenance"><option value="all">全部</option><option value="official">官方核验</option><option value="aggregate">聚合数据</option></select></label>
    <label>排序字段<select name="sort"><option value="inputPrice">输入价格（原币种）</option><option value="outputPrice">输出价格（原币种）</option><option value="cacheReadPrice">Cache read（原币种）</option><option value="cacheWritePrice">Cache write（原币种）</option></select></label>
  </form>
  <p class="meta">排序口径：先分组（USD 条目组在前、CNY 条目组在后），组内按原币种价格升序；跨币种不排名。</p>

  <div class="table-wrap">
    <table class="pricing-table">
      <thead>
        <tr>
          <th>厂商 / 模型</th>
          <th>溯源</th>
          <th>输入（原币种）/1M</th>
          <th>输出（原币种）/1M</th>
          <th>Cache read（原币种）/1M</th>
          <th>Cache write（原币种）/1M</th>
          <th>上下文</th>
          <th>计价口径</th>
          <th>来源</th>
        </tr>
      </thead>
      <tbody id="api-rows">
        {rows.map(({ item, cells, context, provenance, basis }) => (
          <tr data-id={item.id}>
            <td>
              <strong>{item.provider}</strong><br />{item.model}<br />
              <span class="meta">{basis}</span>
            </td>
            <td><span class:list={['badge', item.provenance === 'official' ? 'badge-official' : 'badge-aggregate']}>{item.provenance === 'official' ? '官方核验' : '聚合数据'}</span><br /><span class="meta">{provenance}</span></td>
            <td class="price">{cells.input.main}<br /><span class="meta">{cells.input.sub}</span></td>
            <td class="price">{cells.output.main}<br /><span class="meta">{cells.output.sub}</span></td>
            <td class="price">{cells.cacheRead.main}<br /><span class="meta">{cells.cacheRead.sub}</span></td>
            <td class="price">{cells.cacheWrite.main}<br /><span class="meta">{cells.cacheWrite.sub}</span></td>
            <td>{context}</td>
            <td>{item.pricingCondition}<br /><span class="meta">{item.notes}</span></td>
            <td><a href={item.sourceUrl} rel="noreferrer" target="_blank">来源页</a><br /><span class="meta">{item.verifiedAt}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p id="api-empty" class="meta" hidden>没有符合当前筛选条件的条目。</p>
  <p class="meta">共 {stats.entries} 行。筛选项由 <code>src/scripts/api-table.ts</code> 在浏览器内完成，数据与构建期完全一致，不发网络请求。</p>
  <script id="api-data" type="application/json" set:html={clientData}></script>
  <script src="../scripts/api-table.ts"></script>
</BaseLayout>
