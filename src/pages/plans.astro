---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tokenPlans, DATA_VERIFIED_AT, fxRate } from '../lib/data';
import { formatCnyPrice, formatUsdPrice } from '../lib/format';
import { formatRate } from '../lib/fx';

const monthlyCell = (price: number | null, currency: 'CNY' | 'USD') => {
  if (price === null) return { main: '待核验', sub: '' };
  if (currency === 'CNY') return { main: formatCnyPrice(price), sub: '官方原价' };
  // 美元月费：主列美元，人民币只能作估算副行
  if (!fxRate) return { main: formatUsdPrice(price), sub: '汇率数据缺失，暂不给人民币估算' };
  return {
    main: formatUsdPrice(price),
    sub: `≈ ${formatCnyPrice(price * fxRate.rate)} · 按 ${formatRate(fxRate.rate)} 估算（${fxRate.date}）`,
  };
};
---
<BaseLayout title="Token Plan 比价" description="独立比较订阅型 Token 与 Coding Plan；未核验条目不参与比较。">
  <section class="hero">
    <div class="eyebrow">Token / Coding Plan</div>
    <h1>订阅套餐独立比较</h1>
    <p class="lede">月费并不等于可直接折算的 Token 单价。我们同时核对额度语义、周期、可用模型与自动化或应用后端用途限制。</p>
  </section>
  {tokenPlans.length === 0 ? (
    <section class="empty">
      <div class="eyebrow">Verified only</div>
      <h2>暂无满足核价纪律的 Plan 条目</h2>
      <p>截至 {DATA_VERIFIED_AT}，还没有录入可完整确认月费、额度语义和用途限制的订阅型套餐。未核验条目不会参与比较，我们也不会用演示数字填满表格。</p>
      <p class="meta">后续条目只有在官方来源、核验日期与关键限制齐全后才会出现。</p>
    </section>
  ) : (
    <div class="table-wrap">
      <table>
        <thead><tr><th>厂商 / 套餐</th><th>月费（原币种）</th><th>额度语义</th><th>周期</th><th>可用模型</th><th>用途限制</th><th>来源</th></tr></thead>
        <tbody>
          {tokenPlans.map((item) => {
            const cell = monthlyCell(item.monthlyPrice, item.billingCurrency);
            return (
              <tr>
                <td><strong>{item.provider}</strong><br />{item.plan}</td>
                <td class="price">{cell.main}<br /><span class="meta">{cell.sub}</span></td>
                <td>{item.allowance ?? '待核验'}</td>
                <td>{item.billingCycle ?? '待核验'}</td>
                <td>{item.availableModels.length > 0 ? item.availableModels.join('、') : '待核验'}</td>
                <td>{item.usageRestrictions ?? '待核验'}</td>
                <td><a href={item.sourceUrl} rel="noreferrer" target="_blank">官方页面</a><br /><span class="meta">{item.verifiedAt}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</BaseLayout>
