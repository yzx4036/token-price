---
import '../styles/global.css';
import { sitePath } from '../lib/url';
import { fxRate } from '../lib/data';
import { RATE_DISCLAIMER, fxNote } from '../lib/fx';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title} | Token Price</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="shell nav" aria-label="主导航">
        <a class="brand" href={sitePath()}>Token Price</a>
        <div class="nav-links">
          <a href={sitePath('api-pricing')}>API 比价</a>
          <a href={sitePath('plans')}>Token Plan</a>
          <a href={sitePath('calculator')}>成本计算器</a>
          <a href={sitePath('sources')}>数据来源</a>
          <a href={sitePath('methodology')}>数据口径</a>
        </div>
      </nav>
    </header>
    <main class="shell"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-row">
        <p>Token Price · 面向中文开发者的静态比价工具 · 主列按厂商账单币种</p>
        <p>1 USD = {fxRate.rate} CNY · {fxNote(fxRate)}</p>
      </div>
      <div class="shell footer-row">
        <p class="meta">{RATE_DISCLAIMER}价格并非购买建议，请在使用前复核官方页面。国内厂商为人民币官方原价；国际厂商以美元原价为准，人民币仅为汇率估算副列。</p>
      </div>
    </footer>
  </body>
</html>
